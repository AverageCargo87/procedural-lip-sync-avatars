# Optional environment variables for the local tools (none are secrets). Export them in your shell; nothing reads a .env file.
# Port of the demo server (npm start). The export and measurement tools use 41701-41705.
PORT=41700
# Path to a Chrome or Chromium executable for tools/video.mjs and tools/proverka/*.mjs (default: the installed Chrome channel).
CHROME_PATH=
# Playwright browser channel when CHROME_PATH is empty.
PW_CHANNEL=chrome
