 "lines": [
  {"id":"intro-01","who":"L","text":"Привет! Я Лена.","t0":1.4,"t1":3.08,"words":[["Привет!",1.4,2.04],["Я",2.2,2.36],["Лена.",2.44,3.08]]},
  {"id":"intro-02","who":"A","text":"А я Артём. Сегодня мы разговариваем втроём: Лена, я и ты. Иногда мы будем останавливаться и спрашивать тебя.","t0":3.08,"t1":12.2,"words":[["А",3.08,3.16],["я",3.24,3.48],["Артём.",3.64,4.44],["Сегодня",4.68,5.08],["мы",5.16,5.24],["разговариваем",5.32,5.96],["втроём:",6.04,6.92],["Лена,",7,7.64],["я",7.8,7.96],["и",8.2,8.28],["ты.",8.44,8.68],["Иногда",9.08,9.48],["мы",9.56,9.64],["будем",9.68,9.88],["останавливаться",9.96,10.76],["и",10.84,10.92],["спрашивать",11,11.56],["тебя.",11.64,12.2]]},
  {"id":"l03","who":"L","text":"И отправляемся очень далеко в прошлое. Туда, где ещё нет ни городов, ни письменности.","t0":12.2,"t1":18.84,"words":[["И",12.2,12.28],["отправляемся",12.36,13.08],["очень",13.4,13.72],["далеко",13.8,14.12],["в",14.2,14.28],["прошлое.",14.4,14.92],["Туда,",15.24,15.8],["где",15.84,15.96],["ещё",16.04,16.2],["нет",16.28,16.52],["ни",16.6,16.68],["городов,",16.76,17.56],["ни",17.6,17.64],["письменности.",17.8,18.84]]},
  {"id":"l04","who":"A","text":"Тема урока \u2014 древнейшие люди. А главный вопрос такой: в чём отличие древнейшего человека от обезьяны?","t0":18.84,"t1":26.92,"words":[["Тема",18.84,19.16],["урока",19.24,19.64],["\u2014",19.88,19.92],["древнейшие",19.96,20.76],["люди.",20.84,21.44],["А",21.64,21.72],["главный",21.8,22.12],["вопрос",22.2,22.52],["такой:",22.6,23.4],["в",23.44,23.48],["чём",23.56,23.72],["отличие",23.8,24.36],["древнейшего",24.44,25],["человека",25.08,25.64],["от",25.88,25.96],["обезьяны?",26.04,26.92]]},
  {"id":"l05","who":"L","text":"Запомни его. В конце урока мы ответим на него вместе.","t0":26.92,"t1":30.84,"words":[["Запомни",26.92,27.4],["его.",27.48,27.88],["В",28.04,28.08],["конце",28.12,28.44],["урока",28.52,28.92],["мы",29.08,29.16],["ответим",29.24,29.64],["на",29.68,29.72],["него",29.8,29.96],["вместе.",30.04,30.84]]},
  {"id":"l06","who":"A","text":"Начнём с вопросов, которые люди задавали всегда. Где и когда появился человек?","t0":31.44,"t1":37.52,"words":[["Начнём",31.44,31.84],["с",31.92,32],["вопросов,",32.053,32.6],["которые",32.64,33.04],["люди",33.12,33.28],["задавали",33.36,33.76],["всегда.",33.84,34.4],["Где",34.96,35.36],["и",35.52,35.6],["когда",35.68,36.08],["появился",36.24,36.8],["человек?",36.88,37.52]]},
  {"id":"l07","who":"L","text":"И появился он в одном месте на Земле или в нескольких?","t0":37.52,"t1":41.28,"words":[["И",37.52,37.6],["появился",37.68,38.24],["он",38.32,38.48],["в",38.64,38.72],["одном",38.76,39.04],["месте",39.2,39.4],["на",39.44,39.52],["Земле",39.56,39.92],["или",40.16,40.32],["в",40.36,40.4],["нескольких?",40.48,41.28]]}
